---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const services = [
  { title: 'New Construction Plumbing', href: '/services/new-construction' },
  { title: 'Remodel & Renovation', href: '/services/remodel-renovation' },
  { title: 'Drain & Sewer Services', href: '/services/drain-sewer' },
  { title: 'Water Heater Services', href: '/services/water-heater' },
  { title: 'Fixture Installation', href: '/services/fixture-installation' },
  { title: 'Emergency Plumbing', href: '/services/emergency' },
];
---

<Layout
  title="Page Not Found | Daley Plumbing"
  description="That page isn't here anymore. Find Daley Plumbing's services, service areas, and contact details — or call (224) 430-1420."
>
  <Header />
  <main id="main">
    <section class="pt-28 md:pt-36 pb-16 bg-primary text-white">
      <div class="container mx-auto px-4 text-center">
        <p class="text-white/60 uppercase tracking-widest text-sm mb-4">404</p>
        <h1 class="font-display text-5xl md:text-7xl mb-4">This Page Sprung a Leak</h1>
        <p class="text-xl text-white/80 max-w-2xl mx-auto mb-8">
          The page you were after isn't here. Everything else still is — and the phone still works.
        </p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <a href="tel:2244301420" class="inline-flex items-center gap-3 bg-white text-primary px-8 py-4 font-semibold hover:bg-secondary transition-all">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/>
            </svg>
            Call (224) 430-1420
          </a>
          <a href="/" class="inline-block border-2 border-white/80 text-white px-8 py-4 font-semibold hover:bg-white hover:text-primary transition-all">
            Back to Home
          </a>
        </div>
      </div>
    </section>

    <section class="py-20 bg-secondary">
      <div class="container mx-auto px-4">
        <div class="max-w-3xl mx-auto">
          <h2 class="font-display text-3xl md:text-4xl text-primary mb-8">What Were You Looking For?</h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-10">
            {services.map(service => (
              <a href={service.href} class="bg-white p-5 border-l-4 border-primary hover:shadow-md transition-shadow">
                <span class="font-display text-xl text-primary">{service.title}</span>
              </a>
            ))}
          </div>
          <div class="flex flex-wrap gap-4">
            <a href="/areas" class="text-primary font-semibold hover:text-accent transition-colors">Service areas &rarr;</a>
            <a href="/about" class="text-primary font-semibold hover:text-accent transition-colors">About Daley Plumbing &rarr;</a>
            <a href="/contact" class="text-primary font-semibold hover:text-accent transition-colors">Get a free estimate &rarr;</a>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
