# Web3Forms access key — get one free at https://web3forms.com (enter nate@plumbingdaley.com
# and the key arrives by email). This is a public, client-side key by design; it only
# authorizes sending to the inbox it was issued for.
#
# REQUIRED: without it, every estimate form on the site tells visitors to call instead
# of submitting. Set the same value in the Vercel project's Environment Variables.
PUBLIC_WEB3FORMS_KEY=

# Optional — Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX).
# When empty, no analytics script is loaded.
PUBLIC_GA4_ID=
